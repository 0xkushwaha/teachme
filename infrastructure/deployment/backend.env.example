# Production backend environment for infrastructure/deployment/docker-compose.prod.yml
# (self-hosted VM / Docker path). Copy to backend.env on the server — never commit backend.env.
# On Render, these values are managed by render.yaml + the Render dashboard instead.
#
# Generate secrets with:
#   openssl rand -base64 48   (JWT_ACCESS_SECRET)
#   openssl rand -base64 32   (DATA_ENCRYPTION_KEY — must decode to exactly 32 bytes)
#   openssl rand -hex 24      (METRICS_TOKEN)

NODE_ENV=production
PORT=4000
LOG_LEVEL=info
RUN_WORKERS_IN_API=false

# Public origin: UI and API are served from the same origin behind nginx
APP_URL=https://teachme.example
API_URL=https://teachme.example
CORS_ORIGINS=https://teachme.example
# nginx is the only proxy in front of the API in this topology
TRUST_PROXY=1

# Managed services (TLS strongly recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/teachme?schema=public&sslmode=require&connection_limit=20
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Auth & crypto
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Ops
METRICS_TOKEN=
THROTTLE_GLOBAL_LIMIT=300

# Razorpay (live keys start with rzp_live_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth — redirect URI must be registered exactly in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://teachme.example/api/v1/integrations/google/callback

# SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TeachMe <no-reply@teachme.example>"
SUPPORT_EMAIL=support@teachme.example
