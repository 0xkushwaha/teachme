# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
# Public URL of the frontend (used in emails, OAuth redirects, CORS allow-list)
APP_URL=http://localhost:3000
# Public URL where this API is reachable (used for OAuth callback URL)
API_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Set to "true" to run queue workers inside the API process (dev convenience; prod runs `worker.js`)
RUN_WORKERS_IN_API=false

# ---------- Data stores ----------
DATABASE_URL=postgresql://teachme:teachme_dev_password@localhost:5432/teachme?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookie domain for production (e.g. .teachme.example). Leave empty for host-only cookies.
COOKIE_DOMAIN=
COOKIE_SECURE=false
# 32-byte key, base64. Encrypts OAuth refresh tokens at rest (AES-256-GCM). openssl rand -base64 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY=

# ---------- Razorpay (test mode keys start with rzp_test_) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Google OAuth / Calendar / Meet ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

# ---------- Email (any SMTP provider: Postmark, SES, SendGrid, Resend, Mailpit for dev) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TeachMe <no-reply@teachme.local>"
SUPPORT_EMAIL=support@teachme.local


# ---------- Ops ----------
# Bearer token required to scrape /metrics (required in production)
METRICS_TOKEN=
# Number of reverse-proxy hops to trust for client IPs (1 behind a single load balancer)
TRUST_PROXY=0
# Default per-client requests/minute (stricter limits apply to auth, booking and payment routes)
THROTTLE_GLOBAL_LIMIT=300
